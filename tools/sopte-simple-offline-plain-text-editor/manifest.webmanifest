{
  "name": "SOPTE - Simple Offline Plain Text Editor",
  "short_name": "SOPTE",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#f0f0f0",

  "launch_handler": {
    "client_mode": "navigate-new"
  },


  "file_handlers": [
    {
      "action": "./?file-handler=1",
      "accept": {
        "text/plain": [".txt", ".log"],
        "text/markdown": [".md"],
        "text/html": [".html", ".htm"],
        "text/css": [".css"],
        "text/javascript": [".js"],
        "application/json": [".json"],
        "text/csv": [".csv"],
        "text/tab-separated-values": [".tsv"],
        "application/xml": [".xml"],
        "image/svg+xml": [".svg"]
      },
      "launch_type": "multiple-clients"
    }
  ],

  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}